import os
import re
import time
import logging
import requests
from urllib.parse import urlparse, parse_qs, urlencode, urlunparse
from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

# ---------------------------------------------------------
# Config (set these in Railway's Variables tab)
# ---------------------------------------------------------
BOT_TOKEN = os.environ.get("BOT_TOKEN")

# The URL query parameter your referral code lives in.
# Examples: Binance uses "ref", Bybit uses "affiliate_id", some use "r" or "code".
REF_PARAM = os.environ.get("REF_PARAM", "ref")

# Your referral/affiliate code value.
REF_CODE = os.environ.get("REF_CODE", "873")

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)
logger = logging.getLogger(__name__)

URL_REGEX = re.compile(r"(https?://[^\s]+)")


# ---------------------------------------------------------
# Helpers
# ---------------------------------------------------------
def convert_link(long_url: str) -> str:
    """Replace or append the referral parameter on a URL with our own code."""
    parsed = urlparse(long_url)
    query = parse_qs(parsed.query)

    # Overwrite (or add) the referral parameter
    query[REF_PARAM] = [REF_CODE]

    new_query = urlencode(query, doseq=True)
    rewritten = urlunparse(
        (parsed.scheme, parsed.netloc, parsed.path, parsed.params, new_query, parsed.fragment)
    )
    return rewritten


def shorten_url(long_url: str) -> str:
    """Shorten a URL using the free TinyURL API (no key required)."""
    try:
        response = requests.get(
            "https://tinyurl.com/api-create.php",
            params={"url": long_url},
            timeout=10,
        )
        if response.status_code == 200 and response.text.startswith("http"):
            return response.text.strip()
        return long_url
    except requests.RequestException as e:
        logger.error(f"Error shortening URL: {e}")
        return long_url


# ---------------------------------------------------------
# Handlers
# ---------------------------------------------------------
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "👋 Welcome to Trading Link Bot!\n\n"
        "Send me any trading/exchange link and I'll rewrite it with your "
        "referral code, then shorten it for easy sharing.\n\n"
        "Commands:\n"
        "/start - Show this message\n"
        "/help - How to use this bot"
    )


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Paste a link (e.g. https://exchange.com/signup?ref=someoneelse) "
        "and I'll swap in your referral code and shorten it."
    )


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        text = update.message.text or ""
        match = URL_REGEX.search(text)

        if not match:
            await update.message.reply_text(
                "That doesn't look like a link. Send me a URL starting with http:// or https://"
            )
            return

        long_url = match.group(1)
        converted_url = convert_link(long_url)
        short_url = shorten_url(converted_url)

        await update.message.reply_text(
            f"✅ Converted link:\n{converted_url}\n\n"
            f"🔗 Shortened:\n{short_url}"
        )
    except Exception as e:
        # Never let a single bad message crash the whole bot
        logger.error(f"Error handling message: {e}")
        try:
            await update.message.reply_text(
                "⚠️ Something went wrong processing that link. Please try again."
            )
        except Exception:
            pass


async def on_error(update: object, context: ContextTypes.DEFAULT_TYPE):
    """Global error handler so unexpected exceptions never crash the process."""
    logger.error(f"Unhandled error: {context.error}", exc_info=context.error)


def build_app():
    if not BOT_TOKEN:
        raise RuntimeError(
            "BOT_TOKEN environment variable is not set. "
            "Set it in Railway's Variables tab."
        )

    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.add_error_handler(on_error)

    return app


def main():
    # Outer loop: if run_polling ever exits due to a network/connection error,
    # wait a moment and restart instead of letting the process die.
    while True:
        try:
            app = build_app()
            logger.info("Bot starting...")
            app.run_polling(drop_pending_updates=True, close_loop=False)
        except Exception as e:
            logger.error(f"Bot crashed with error: {e}. Restarting in 5 seconds...")
            time.sleep(5)
        else:
            # run_polling returned normally (rare) - restart anyway to stay alive
            logger.warning("Polling stopped unexpectedly. Restarting in 5 seconds...")
            time.sleep(5)


if __name__ == "__main__":
    main()
